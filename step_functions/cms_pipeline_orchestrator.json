{
  "Comment": "CMS pipeline: run the Glue ETL (with in-job data-quality checks), then notify via SNS. Started by the cms-file-validator Lambda after a valid upload.",
  "StartAt": "Glue StartJobRun",
  "States": {
    "Glue StartJobRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "cms-etl-transform"
      },
      "Next": "Send-Success-Notification",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Send-Failure-Notification"
        }
      ]
    },
    "Send-Success-Notification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-2:933022095648:cms-pipeline-alerts",
        "Message": "CMS Pipeline completed successfully! The Glue ETL job (with data-quality checks) processed the latest CMS provider data."
      },
      "End": true
    },
    "Send-Failure-Notification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-2:933022095648:cms-pipeline-alerts",
        "Message": "CMS Pipeline FAILED! Please check the Glue job logs."
      },
      "End": true
    }
  },
  "QueryLanguage": "JSONPath",
  "TimeoutSeconds": 1800
}
